# =====================================================================
# Copy this file to `.env.local` for local development:   cp .env.example .env.local
# In Vercel, add the same names under Project → Settings → Environment Variables.
# NEVER commit .env.local. Only NEXT_PUBLIC_* values ever reach the browser.
# =====================================================================

# --- Supabase (Dashboard → Project Settings → API / API Keys) --------------
# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or legacy "anon" key. Safe in the browser: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret / service_role key. SERVER ONLY (email worker & cron). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL -----------------------------------------------------------------
# Local:      http://localhost:3000
# Production: https://your-domain.com  (or https://your-project.vercel.app)
# Used for email links and auth redirects. Must also be added in
# Supabase → Authentication → URL Configuration (Site URL + Redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend, Phase 6) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Pilates Studio <bookings@your-domain.com>"

# --- Scheduled jobs (Phase 6) ----------------------------------------------------
# Long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# --- Native apps (optional, only when publishing to the stores) -----------------
ANDROID_PACKAGE_NAME=
# Comma-separated SHA-256 fingerprints of the Play app signing key
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=
